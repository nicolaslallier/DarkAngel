# Copy to .portainer.env (gitignored) and fill in. Used by
# scripts/portainer-stack.sh, i.e. `make up`, `down`, `pull`, `delete`,
# `webhook`.
#
# PORTAINER_API_KEY is a Docker-daemon-root token: it lives here rather than
# in .env because it must never be handed to a container or committed.
# Create one under Portainer -> My account -> Access tokens.
PORTAINER_API_KEY=change-me

# Optional. Defaults to the first local Docker environment in Portainer.
#PORTAINER_ENDPOINT_ID=1

# Optional, for a setup that differs from the Infra stack's defaults:
#PORTAINER_URL=https://portainer:9443          # as seen from the curl container
#PORTAINER_NETWORK=infra-net                   # network that reaches Portainer
#PORTAINER_PUBLIC_URL=https://portainer.infra.famillelallier.net
#PORTAINER_REF=refs/heads/main                 # branch Portainer deploys

# Secret key of the MinIO user darkangel-api (bucket darkangel-files), which the
# API stores home files with. At least 8 characters. `make minio` applies it to
# the Infra MinIO and `make up` hands it to the stack -- run both after changing it.
MINIO_SECRET_KEY=change-me

# Password of the PostgreSQL role darkangel (database darkangel) in the Infra
# PostgreSQL, which the API stores file metadata in. `make postgres` applies it
# and `make up` hands it to the stack -- run both after changing it.
POSTGRES_PASSWORD=change-me
