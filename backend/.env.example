DARKANGEL_DEBUG=false
DARKANGEL_CORS_ORIGINS=["http://localhost:5173"]

# Keycloak realm `ea` (defaults shown). The backend fetches the realm's signing
# keys over HTTPS; locally, Python does not trust the Infra CA, so start it with
# SSL_CERT_FILE pointing at Infra's certs/infra-ca.crt (README "Authentication").
# DARKANGEL_AUTH_ISSUER=https://keycloak.famillelallier.net/realms/ea
# DARKANGEL_AUTH_AUDIENCE=darkangel-api
# DARKANGEL_AUTH_JWKS_URL=
